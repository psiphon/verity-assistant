# Copy to `.env` (which is gitignored) and edit.

# Shared secret between the Fish Audio server and Verity. Any non-empty string.
# Set the SAME value in Verity: Settings -> Speak replies aloud -> Fish Audio ->
# "API key". Change it from this default.
FISH_API_KEY=verity-local-fish-key

# Host port the API is published on. 8080 collides with a lot of local dev
# servers (llama.cpp, etc.) - pick a free one and use the same port in Verity's
# "Server URL" (http://localhost:<port>).
FISH_PORT=8081

# `cuda` or `cpu`, used at BUILD time. For `cpu`, also remove the `deploy:`
# block in compose.yml and rebuild.
FISH_BACKEND=cuda

# Match these to your CUDA toolkit if the default 12.9 image doesn't fit your
# driver. UV_EXTRA is one of cu126 / cu128 / cu129. BUILD time only.
FISH_CUDA_VER=12.9.0
FISH_UV_EXTRA=cu129

# torch.compile (long first-request warmup, faster after) isn't wired to an
# env var - add "--compile" to the `command:` list in compose.yml if you want it.
